#!/bin/bash
# Video Downloader for Mac. Sets itself up on first open, then starts the
# downloader and opens it in the browser.
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
DATA="$HOME/Library/Application Support/Video Downloader"
VENV="$DATA/venv"
URL="http://127.0.0.1:8765"
mkdir -p "$DATA"

say_dialog() { osascript -e "display dialog \"$1\" with title \"Video Downloader\" buttons {\"OK\"} default button 1" >/dev/null 2>&1; }

# Already running: just open it.
if curl -s -o /dev/null "$URL/api/ping"; then open "$URL"; exit 0; fi

# Run natively on Apple chips.
ARCH=""; [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ] && ARCH="arch -arm64"

# First open: build a private Python environment with everything it needs.
if [ ! -x "$VENV/bin/python" ] || [ "$RES/requirements.txt" -nt "$DATA/.installed" ]; then
  PY=""
  for c in /opt/homebrew/bin/python3 /usr/local/bin/python3 \
           /Library/Frameworks/Python.framework/Versions/Current/bin/python3 /usr/bin/python3; do
    if [ -x "$c" ] && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
      PY="$c"; break
    fi
  done
  if [ -z "$PY" ]; then
    ans=$(osascript -e 'display dialog "Video Downloader needs Python 3. Install it, then open Video Downloader again." with title "Video Downloader" buttons {"Cancel", "Get Python"} default button 2' 2>/dev/null)
    [[ "$ans" == *"Get Python"* ]] && open "https://www.python.org/downloads/macos/"
    exit 1
  fi
  osascript -e 'display notification "Setting up. This only happens the first time and takes about a minute." with title "Video Downloader"' >/dev/null 2>&1
  rm -rf "$VENV"
  if ! $ARCH "$PY" -m venv "$VENV" > "$DATA/setup.log" 2>&1 \
     || ! $ARCH "$VENV/bin/python" -m pip install -q -U pip -r "$RES/requirements.txt" >> "$DATA/setup.log" 2>&1; then
    say_dialog "Setup didn't finish. Check your internet connection and open Video Downloader again."
    exit 1
  fi
  touch "$DATA/.installed"
fi

VBD_DATA="$DATA" nohup $ARCH "$VENV/bin/python" "$RES/server.py" > "$DATA/server.log" 2>&1 &
disown
for i in $(seq 1 80); do curl -s -o /dev/null "$URL/api/ping" && break; sleep 0.25; done
open "$URL"
